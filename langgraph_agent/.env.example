# vLLM Configuration
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=your-secret-key
LLM_MODEL=Qwen/Qwen2.5-72B-Instruct-AWQ
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=120

# Agent Configuration
MAX_ITERATIONS=100
MAX_TOOL_RETRIES=3
ENABLE_REFLECTION=true
REFLECTION_FREQUENCY=5

# TheAgentCompany Environment
SERVER_HOSTNAME=localhost
GITLAB_URL=http://localhost:8929
ROCKETCHAT_URL=http://localhost:3000
OWNCLOUD_URL=http://localhost:8092
PLANE_URL=http://localhost:8091

# Logging
LOG_LEVEL=INFO
ENABLE_TRAJECTORY_LOGGING=true
