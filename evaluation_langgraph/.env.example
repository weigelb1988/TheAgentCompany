# Environment variables for LangGraph Agent Evaluation

# Agent LLM (vLLM) - Powers the agent
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=your-secret-key
LLM_MODEL=Qwen/Qwen2.5-72B-Instruct-AWQ

# Environment LLM - Powers NPCs and evaluators
# Option 1: Use same vLLM
ENV_LLM_API_KEY=your-secret-key
ENV_LLM_BASE_URL=http://localhost:8000/v1
ENV_LLM_MODEL=Qwen/Qwen2.5-72B-Instruct-AWQ

# Option 2: Use OpenAI
# ENV_LLM_API_KEY=sk-...
# ENV_LLM_BASE_URL=https://api.openai.com/v1
# ENV_LLM_MODEL=gpt-4o

# Option 3: Use Anthropic (requires litellm proxy)
# ENV_LLM_API_KEY=sk-ant-...
# ENV_LLM_BASE_URL=https://api.anthropic.com
# ENV_LLM_MODEL=claude-3-5-sonnet-20241022

# TheAgentCompany Services
SERVER_HOSTNAME=localhost

# Evaluation Settings
MAX_ITERATIONS=100
ENABLE_REFLECTION=true
